# =============================================================================
# AstraForge AI — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_IDS=123456789
# Comma-separated Telegram user IDs that may control the bot.
# Get your ID via @userinfobot

# --- Exchange (required for trading) ---
# Supported: binance, bybit
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_api_key_read_and_futures_only
EXCHANGE_API_SECRET=your_api_secret
# NEVER enable Withdrawal on API keys. Prefer IP whitelist.

# --- Trading mode ---
# paper = testnet (DEFAULT, safe). live = real money (requires LIVE_CONFIRMED=true)
TRADING_MODE=paper
LIVE_CONFIRMED=false

# --- LLM provider ---
# openai | anthropic | ollama | xai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key
# For Ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# For xAI (Grok):
# LLM_PROVIDER=xai
# LLM_MODEL=grok-2-latest
# LLM_BASE_URL=https://api.x.ai/v1

# --- Risk limits (hard-coded defaults; these can only be tightened, not loosened above code max) ---
DAILY_LOSS_LIMIT_PCT=2.5
MAX_DRAWDOWN_PCT=6.0
MAX_LEVERAGE=5
MAX_POSITION_PCT=3.5

# --- Universe ---
TRADE_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,BNB/USDT:USDT,XRP/USDT:USDT

# --- App ---
DATABASE_PATH=/app/data/astraforge.db
LOG_LEVEL=INFO
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
AGENT_LOOP_INTERVAL_SEC=60
DEFAULT_RISK_PROFILE=balanced
# paper starting equity (testnet may report 0)
PAPER_STARTING_EQUITY=10000
